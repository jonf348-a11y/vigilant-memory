ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Default is a local SQLite file. On Railway, set this to sqlite:////data/grants.db
# after adding a Volume mounted at /data.
DATABASE_URL=sqlite:///./grants.db

# --- Usage alerts (optional) ---
# When set, the app emails a notification each time the expensive agent is used
# (a full or targeted grant search). Leave blank to disable — searches still run.
# Delivery is via Resend's HTTPS API (https://resend.com), because Railway's
# Hobby plan blocks outbound SMTP. Get a free API key from the Resend dashboard.
RESEND_API_KEY=re_your_resend_api_key
# Optional overrides:
# ALERT_FROM defaults to "onboarding@resend.dev" (works with no domain setup).
ALERT_FROM=
ALERT_TO=jonf348@googlemail.com
